<?xml version="1.0" encoding="utf-8"?>
<log4net>

	<!-- ASM log -->
	<appender name="ASMAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/ASMLog/ASM_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>
	<!-- Sequence Test log -->
	<appender name="SequenceTestAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/SequenceTest/SequenceTest_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>
	<!-- Initialize log -->
	<appender name="InitializeAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/InitializeLog/Init_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>

	<!-- ASP Board log -->
	<appender name="ASPBoardAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/ASPBoardLog/ASPBoard_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>
	<!-- UC Testing log -->
	<appender name="UCTestingAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/UCTesting/UCTesting_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>

	<!-- API / ApiFallback log -->
	<appender name="ApiFallbackAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/ApiFallback/ApiFallback_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>

	<!-- PLC Interface log -->
	<appender name="PLCInterfaceAppender" type="log4net.Appender.RollingFileAppender">
		<file value="Logs/PLCInterfaceLog/PLCInterface_" />
		<appendToFile value="true" />
		<rollingStyle value="Date" />
		<datePattern value="yyyyMMdd'.log'" />
		<staticLogFileName value="false" />
		<layout type="log4net.Layout.PatternLayout">
			<conversionPattern value="[%date{yyyy-MM-dd HH:mm:ss}] [%-5level] - %message%newline" />
		</layout>
	</appender>

	<!-- Liên kết từng logger riêng -->
	<logger name="ASMLogger">
		<level value="DEBUG" />
		<appender-ref ref="ASMAppender" />
	</logger>
	<logger name="SequenceTestLogger">
		<level value="DEBUG" />
		<appender-ref ref="SequenceTestAppender" />
	</logger>
	<logger name="InitializeLogger">
		<level value="DEBUG" />
		<appender-ref ref="InitializeAppender" />
	</logger>
	<logger name="ASPBoardLogger">
		<level value="DEBUG" />
		<appender-ref ref="ASPBoardAppender" />
	</logger>
	<logger name="UCTestingLogger">
		<level value="DEBUG" />
		<appender-ref ref="UCTestingAppender" />
	</logger>
	<logger name="ApiFallbackLogger">
		<level value="DEBUG" />
		<appender-ref ref="ApiFallbackAppender" />
	</logger>
	<logger name="APILogger">
		<level value="DEBUG" />
		<appender-ref ref="ApiFallbackAppender" />
	</logger>
	<logger name="PLCInterfaceLogger">
		<level value="DEBUG" />
		<appender-ref ref="PLCInterfaceAppender" />
	</logger>
	<!-- Root logger (tùy chọn, để chung) -->
	<root>
		<level value="INFO" />
	</root>
</log4net>

